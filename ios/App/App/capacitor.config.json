{
	"appId": "is.valentin.starfall",
	"appName": "Starfall",
	"webDir": "public",
	"backgroundColor": "#02030aff",
	"appendUserAgent": "StarfallApp",
	"server": {
		"url": "https://starfall.valentin.is",
		"androidScheme": "https"
	},
	"ios": {
		"contentInset": "always",
		"backgroundColor": "#02030aff",
		"scrollEnabled": false
	},
	"android": {
		"backgroundColor": "#02030aff",
		"allowMixedContent": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 800,
			"backgroundColor": "#02030a",
			"showSpinner": false
		}
	},
	"packageClassList": [
		"AppPlugin"
	]
}
